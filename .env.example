# Copy to .env and fill in. Never commit .env.
# One database URL for everyone (pipeline, API and ai/ scripts read it).
DB_URL=mysql://ghosts:ghosts@127.0.0.1:3306/ghosts

# Gemma on Featherless: translations, biographies, English on "Same story, every language"
FEATHERLESS_API_KEY=
TRANSLATE_MODEL=google/gemma-4-31B-it
TRANSLATE_WORKERS=2
# BIO_MODEL=google/gemma-4-31B-it

# EmbeddingGemma on Modal (meaning search): the URL `modal deploy ai/embed_modal.py` prints
EMBED_URL=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

GEMINI_API_KEY=
